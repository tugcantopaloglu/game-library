{
  "name": "game-library",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @game-library/desktop dev",
    "build": "pnpm --filter @game-library/desktop build",
