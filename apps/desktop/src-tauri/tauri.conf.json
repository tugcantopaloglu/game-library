{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Library",
  "version": "0.1.0",
  "identifier": "dev.gamelibrary.desktop",
  "build": {
    "beforeDevCommand": "pnpm ui:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm ui:build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
