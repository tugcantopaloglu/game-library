import { TextEdit, CheckBox, ListView, ScrollView, ComboBox, AboutSlint, Palette } from "std-widgets.slint";
import { Theme, Glyph, Action, Navigation, Field, Panel, Heading, Caption, Eyebrow, Metric, Tab, PersonRow, FriendRow } from "design.slint";
export struct CollectionTile { id: int, name: string, count: int }
export struct CoverTile { title: string, url: string }
export struct SocialTile { id: string, name: string, subtitle: string, initial: string, online: bool, favorite: bool, recent: string }
export struct RoomTile { id: string, name: string, subtitle: string, online: bool, favorite: bool, can-join: bool }
export struct GameTile { id: string, name: string, size: string, installed: bool, favorite: bool, artwork: image, has-artwork: bool, source: string, status-label: string }
component GameCard inherits Rectangle {
    in property <GameTile> game;
    callback launch(string);
    callback favorite(string, bool);
    callback detail(string);
    opacity: game.id == "" ? 0 : 1;
    min-width: 0px; background: transparent;
    forward-focus: card-focus;
    accessible-role: button; accessible-label: game.name + " ayrıntıları"; accessible-enabled: game.id != "";
    accessible-action-default => { if game.id != "" { root.detail(game.id); } }
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height - 66px; border-radius: 11px; clip: true;
        background: Theme.surface;
        if game.has-artwork: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: game.artwork; image-fit: ImageFit.cover; }
        if game.has-artwork: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: @image-url("icons/cover-corners.svg"); colorize: Theme.canvas; image-fit: ImageFit.fill; }
        if !game.has-artwork: VerticalLayout { padding: 18px; spacing: 14px;
            Rectangle { vertical-stretch: 1; background: transparent; }
            Glyph { kind: 0; width: 32px; height: 32px; ink: Theme.subtle; }
            Text { text: game.source; color: Theme.subtle; font-size: 12px; vertical-stretch: 0; horizontal-alignment: center; }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
        poster-touch := TouchArea { enabled: game.id != ""; mouse-cursor: pointer; clicked => { card-focus.focus(); root.detail(game.id); } }
        if game.favorite || poster-touch.has-hover || card-focus.has-focus: Rectangle {
            x: parent.width - 42px; y: 10px; width: 32px; height: 32px; border-radius: 16px; background: #13141ae8;
            Glyph { x: 8px; y: 8px; width: 16px; height: 16px; kind: 1; filled: game.favorite; ink: game.favorite ? Theme.accent : Theme.text; }
            TouchArea { mouse-cursor: pointer; clicked => { root.favorite(game.id,!game.favorite); } }
        }
        if !game.installed: Rectangle {
            x: 10px; y: parent.height - 32px; height: 22px; width: 90px; border-radius: 5px; background: #13141ae8;
            Text { text: game.status-label; color: Theme.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle { width: parent.width; height: parent.height; border-radius: 11px; background: transparent; border-width: card-focus.has-focus || poster-touch.has-hover ? 2px : 0px; border-color: Theme.accent; }
    }
    Rectangle {
        x: 0px; y: parent.height - 57px; width: parent.width - 34px; height: 52px; background: transparent;
        VerticalLayout { spacing: 5px;
            Text { text: game.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; vertical-stretch: 0; }
            Text { text: game.source + (game.installed ? " · " + game.size : ""); color: Theme.subtle; font-size: 11px; overflow: elide; vertical-stretch: 0; }
        }
        TouchArea { enabled: game.id != ""; mouse-cursor: pointer; clicked => { root.detail(game.id); } }
    }
    if poster-touch.has-hover || card-focus.has-focus: Action { x: parent.width - 32px; y: parent.height - 53px; width: 32px; height: 32px; text: ""; icon: 9; ghost: true; enabled: game.installed; accessible-label: game.name + " başlat"; clicked => { root.launch(game.id); } }
    ContextMenuArea { enabled: game.id != ""; Menu {
        MenuItem { title: "Oyna"; enabled: game.installed; activated => { root.launch(game.id); } }
        MenuItem { title: "Ayrıntılar"; activated => { root.detail(game.id); } }
        MenuItem { title: game.favorite ? "Favorilerden çıkar" : "Favoriye ekle"; activated => { root.favorite(game.id,!game.favorite); } }
    } }
    card-focus := FocusScope { enabled: game.id != ""; key-pressed(event) => { if event.text == "\n" || event.text == " " { root.detail(game.id); return accept; } if event.text == "p" && game.installed { root.launch(game.id); return accept; } if event.text == "f" { root.favorite(game.id,!game.favorite); return accept; } return reject; } }
}
export component AboutWindow inherits Window {
    title: "Game Library hakkında";
    preferred-width: 420px;
    preferred-height: 300px;
    background: #181c20;
    VerticalLayout {
        padding: 26px;
        spacing: 18px;
        Text { vertical-stretch: 0; text: "Game Library"; color: #f1f3f5; font-size: 24px; font-weight: 600; }
        Text { vertical-stretch: 0; text: "0.1.0 · Windows\nKişisel oyun kütüphanesi"; color: #aab4bf; font-size: 13px; }
        AboutSlint {}
    }
}

export component LibraryTray inherits SystemTrayIcon {
    icon: @image-url("../../desktop/src-tauri/icons/icon.png");
    tooltip: "Game Library";
    callback open;
    callback exit;
    clicked => { root.open(); }
    Menu {
        MenuItem { title: "Kütüphaneyi aç"; activated => { root.open(); } }
        MenuSeparator {}
        MenuItem { title: "Çıkış"; activated => { root.exit(); } }
    }
}

export component LibraryWindow inherits Window {
    title: "Game Library";
    icon: @image-url("../../desktop/src-tauri/icons/icon.png");
    preferred-width: 1280px; preferred-height: 720px;
    min-width: 960px; min-height: 640px;
    max-width: 4096px; max-height: 2160px;
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    in property <[[GameTile]]> game-rows;
    in property <int> total;
    in property <int> installed-count;
    in property <int> favorite-count;
    in property <int> steam-count;
    in property <int> epic-count;
    in property <int> riot-count;
    in property <int> manual-count;
    in property <[CollectionTile]> collections;
    in property <[string]> collection-names;
    in-out property <int> collection-id;
    in-out property <string> collection-name;
    in-out property <int> detail-collection-index;
    in-out property <string> detail-id;
    in-out property <string> detail-title;
    in-out property <string> detail-notes;
    in property <string> detail-path;
    in property <string> detail-history;
    in property <string> detail-collections;
    in property <bool> detail-installed;
    in property <image> detail-artwork;
    in property <string> completion-summary: "HowLongToBeat süresi henüz alınmadı.";
    in-out property <string> completion-url;
    in-out property <string> steam-account-id;
    in-out property <string> steam-api-key;
    in property <string> steam-account-status;
    in property <string> epic-account-status;
    in-out property <string> remote-cover-url;
    in-out property <bool> bridge-enabled;
    in property <bool> bridge-connected;
    in property <bool> can-mute;
    in property <bool> can-deafen;
    in property <bool> can-stop-stream;
    in property <bool> muted;
    in property <bool> deafened;
    in property <string> bridge-status: "Yerel Discord/Vencord bağlantısı kapalı.";
    in property <bool> can-favorite-friends;
    in property <bool> recent-conversations;
    in property <bool> social-fixture;
    in property <int> friend-count;
    in property <int> favorite-friend-count;
    in-out property <string> friend-query;
    in-out property <bool> friend-favorites-only;
    in property <bool> can-favorite-rooms;
    in property <bool> can-room-catalog;
    in property <int> favorite-room-count;
    in property <bool> room-catalog-pending;
    in property <bool> room-catalog-more;
    in-out property <int> room-mode;
    in-out property <string> room-query;
    in-out property <string> discord-target-id;
    in-out property <int> discord-branch;
    in-out property <bool> auto-update-app;
    in-out property <bool> auto-update-vencord: true;
    in property <bool> update-available;
    in property <bool> update-staged;
    in property <bool> integration-busy;
    in property <[CoverTile]> cover-candidates;
    in property <[string]> cover-names;
    in-out property <int> cover-index;
    in-out property <string> artwork-api-key;
    in property <string> update-status: "İmzalı release yayımlandığında güncelleme kullanılabilir.";
    in property <int> matched;
    in property <int> offset;
    in property <int> page-size: 100;
    in property <bool> scanning;
    in property <bool> loading;
    in property <bool> measuring;
    in-out property <string> notice;
    in property <string> scan-notice;
    in property <[string]> source-summaries;
    in property <string> ram: "—";
    in property <string> cpu: "—";
    in property <string> commit-size: "—";
    in property <string> measurement-summary;
    in property <int> measurement-progress;
    in-out property <int> section;
    changed section => { if section != 7 && room-mode == 2 { room-mode = 1; root.room-filter(1,room-query); } }
    in-out property <bool> installed-only;
    in-out property <string> query;
    in-out property <length> scroll-position;
    in-out property <int> source-index;
    callback refresh(string, bool, bool, int, int);
    callback scan;
    callback cancel-scan;
    callback add-folder(int);
    callback launch(string);
    callback favorite(string, bool);
    callback sample;
    callback measure;
    callback cancel-measurement;
    callback open-reports;
    callback hide-window;
    callback about;
    callback quit;
    callback focus-idle;
    callback library-ready;
    callback bridge-ready;
    callback add-manual;
    callback tracking(string);
    callback detail(string);
    callback save-detail(string,string,string);
    callback cover(string,bool);
    callback remote-cover(string,string);
    callback create-collection(string);
    callback delete-collection(int);
    callback collection-member(string,int,bool);
    callback bridge-toggle(bool);
    callback social-filter(string,bool);
    callback friend-favorite(string,bool);
    callback room-filter(int,string);
    callback room-favorite(string,bool);
    callback bridge-action(string,string);
    callback installer(int,int);
    callback prepare-bridge;
    callback artwork-key(string);
    callback search-covers(string);
    callback steam-credentials(string,string);
    callback steam-key-page;
    callback sync-account(int);
    callback epic-login;
    callback completion-lookup(string,string);
    callback completion-open(string,bool);
    callback update-check;
    callback update-stage;
    callback update-apply;
    callback update-preferences(bool,bool);
    focus-idle => { idle-focus.focus(); }
    forward-focus: idle-focus;
    idle-focus := FocusScope { width: 1px; height: 1px; key-pressed(event) => { if event.modifiers.control && event.text == "f" { if section >= 2 { section = 0; root.refresh(query,false,installed-only,0,source-index); } library-search.focus-input(); return accept; } if event.text == Key.Escape && section == 9 { root.return-to-library(); return accept; } return reject; } }


    in property <string> detail-source;
    in property <string> detail-size;
    in property <bool> detail-favorite;
    in property <bool> detail-has-artwork;
    in property <string> completion-main: "—";
    in property <string> completion-extra: "—";
    in property <string> completion-full: "—";
    in property <[SocialTile]> friends;
    in property <[RoomTile]> rooms;
    in-out property <int> detail-tab;
    in-out property <int> detail-origin;
    function return-to-library() { section = detail-origin; root.refresh(query,section == 1,installed-only,offset,source-index); }
    in-out property <bool> source-details;
    in-out property <bool> discord-settings;
    out property <int> grid-columns: root.width < 1100px ? 4 : root.width < 1280px ? 5 : 6;
    property <length> card-width: (root.width - 184px - 48px - 16px - (grid-columns - 1) * 16px) / grid-columns;
    property <length> card-height: card-width * 1.5 + 58px;
    changed grid-columns => { if section < 2 { root.refresh(query,section == 1,installed-only,offset,source-index); } }
    init => { Palette.color-scheme = ColorScheme.dark; }
    app-keys := FocusScope {
        key-pressed(event) => { if event.modifiers.control && event.text == "f" { if section >= 2 { section = 0; root.refresh(query,false,installed-only,0,source-index); } library-search.focus-input(); return accept; } if event.text == Key.Escape && section == 9 { root.return-to-library(); return accept; } return reject; }
    HorizontalLayout { spacing: 0px;
        Rectangle { width: 184px; background: Theme.sidebar;
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.line; }
            VerticalLayout { padding: 12px; spacing: 12px;
                HorizontalLayout { height: 46px; spacing: 9px; padding-left: 8px;
                    Glyph { kind: 0; ink: Theme.accent; }
                    VerticalLayout { spacing: 3px;
                        Text { text: "Game Library"; color: Theme.text; font-size: 14px; font-weight: 600; vertical-stretch: 0; }
                    }
                }
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { spacing: 4px;
                        Navigation { text: "Kütüphane"; icon: 0; count: "" + total; active: section == 0 && collection-id == 0; clicked => { section = 0; source-index = 0; collection-id = 0; root.refresh(query,false,installed-only,0,0); } }
                        Navigation { text: "Favoriler"; icon: 1; count: "" + favorite-count; active: section == 1; clicked => { section = 1; source-index = 0; collection-id = 0; root.refresh(query,true,installed-only,0,0); } }
                        Navigation { text: "Koleksiyonlar"; icon: 2; active: section == 6; clicked => { section = 6; } }
                        for collection in collections: Navigation { text: collection.name; monogram: "·"; count: "" + collection.count; active: section == 0 && collection-id == collection.id; clicked => { collection-id = collection.id; source-index = 0; section = 0; root.refresh(query,false,installed-only,0,0); } }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
                VerticalLayout { spacing: 4px;
                    Navigation { text: "Discord"; icon: 3; active: section == 7; clicked => { section = 7; } }
                    Navigation { text: "Ayarlar"; icon: 4; active: section == 8 || section == 2 || (section >= 3 && section <= 5) || section == 10; clicked => { section = 8; } }
                    Rectangle { height: 1px; background: Theme.line; }
                    HorizontalLayout { height: 38px; padding-left: 12px; spacing: 9px;
                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: bridge-connected ? Theme.positive : Theme.subtle; }
                        Text { text: bridge-connected ? "Discord bağlı" : "Yerel kütüphane"; color: Theme.subtle; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }
        }
        VerticalLayout { spacing: 0px; horizontal-stretch: 1; max-width: 4096px;
            Rectangle { height: 58px; background: Theme.canvas;
                    library-search := Field { visible: section != 7; x: 24px; y: 12px; width: min(360px,parent.width - 100px); icon: 6; placeholder: "Oyun ara"; text <=> query; edited => { if section >= 2 { section = 0; } root.refresh(query,section == 1,installed-only,0,source-index); } }
                    if section == 7: Field { x: 24px; y: 12px; width: min(360px,parent.width - 100px); icon: 6; placeholder: "Arkadaş ara"; text <=> friend-query; edited => { root.social-filter(friend-query,friend-favorites-only); } }
                    if scanning: Caption { x: parent.width - 210px; y: 12px; width: 140px; height: 34px; text: "Taranıyor…"; font-size: 11px; horizontal-alignment: right; }
                    Rectangle { x: parent.width - 56px; y: 13px; width: 32px; height: 32px; border-radius: 6px; background: options-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button; accessible-label: "Uygulama seçenekleri"; forward-focus: options-keys;
                        accessible-action-default => { options.show({x:0px,y:32px}); }
                        Image { x: 7px; y: 7px; width: 18px; height: 18px; source: @image-url("icons/more.svg"); colorize: Theme.muted; }
                        options-keys := FocusScope { key-pressed(event) => { if event.text == "\n" || event.text == " " { options.show({x:0px,y:32px}); return accept; } return reject; } }
                        options-touch := TouchArea { mouse-cursor: pointer; clicked => { options-keys.focus(); options.show({x:0px,y:32px}); } }
                        options := ContextMenuArea { width: 0px; height: 0px; Menu {
                            MenuItem { title: "Oyun ekle"; activated => { root.add-manual(); } }
                            MenuItem { title: scanning ? "Taramayı durdur" : "Oyunları tara"; activated => { if scanning { root.cancel-scan(); } else { root.scan(); } } }
                            MenuItem { title: "Kaynakları yönet"; activated => { section = 3; } }
                            MenuSeparator {}
                            MenuItem { title: "Tepsiye al"; activated => { root.hide-window(); } }
                            MenuItem { title: "Hakkında"; activated => { root.about(); } }
                            MenuItem { title: "Çıkış"; activated => { root.quit(); } }
                        } }
                    }
                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
            }
            VerticalLayout { padding-left: 24px; padding-right: 24px; padding-top: 14px; padding-bottom: 12px; spacing: 12px;
                if notice != "": Panel { height: 44px;
                    HorizontalLayout { padding-left: 14px; padding-right: 8px; spacing: 10px; Caption { text: notice; font-size: 12px; } Action { text: "×"; ghost: true; min-width: 28px; max-width: 28px; accessible-label: "Bildirimi kapat"; clicked => { notice = ""; } } }
                }
                if scan-notice != "" && (section < 2 || (section >= 3 && section <= 6)): Caption { text: scan-notice; font-size: 11px; color: Theme.subtle; }
                if section != 9: VerticalLayout { spacing: 7px;
                    Text { text: section == 0 ? (collection-id > 0 ? "Koleksiyon" : "Kütüphane") : section == 1 ? "Favoriler" : section == 6 ? "Koleksiyonlar" : section == 7 ? "Discord" : "Ayarlar"; color: Theme.text; font-size: 22px; font-weight: 600; vertical-stretch: 0; }
                    if section < 2: Caption { text: matched + " oyun"; font-size: 11px; }
                }
                if section == 8 || section == 2 || (section >= 3 && section <= 5) || section == 10: HorizontalLayout { spacing: 8px;
                    Tab { text: "Genel"; active: section == 8; clicked => { section = 8; } }
                    Tab { text: "Kaynaklar"; active: section >= 3 && section <= 5; clicked => { section = 3; } }
                    Tab { text: "Discord bağlantısı"; active: section == 10; clicked => { section = 10; } }
                    Tab { text: "Performans"; active: section == 2; clicked => { section = 2; root.sample(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                if section < 2: VerticalLayout { spacing: 18px;
                    HorizontalLayout { spacing: 6px;
                        Tab { text: "Tümü"; active: !installed-only; clicked => { installed-only = false; root.refresh(query,section == 1,false,0,source-index); } }
                        Tab { text: "Kurulu"; active: installed-only; clicked => { installed-only = true; root.refresh(query,section == 1,true,0,source-index); } }
                        if collection-id > 0: Action { text: "Filtreyi kaldır"; ghost: true; clicked => { collection-id = 0; root.refresh(query,section == 1,installed-only,0,source-index); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        ComboBox { width: 156px; model: ["Tüm platformlar", "Steam", "Epic Games", "Riot Games", "Elle eklenen"]; current-index <=> root.source-index; selected(value) => { root.refresh(query,section == 1,installed-only,0,source-index); } }
                    }
                    if matched == 0: VerticalLayout { alignment: center; spacing: 14px;
                        HorizontalLayout { alignment: center; Glyph { kind: query != "" ? 6 : 0; width: 40px; height: 40px; ink: Theme.subtle; } }
                        Heading { text: loading ? "Oyunların yükleniyor…" : query != "" ? "Sonuç bulunamadı" : section == 1 ? "Favorilerin burada görünecek" : "Burada henüz oyun yok"; horizontal-alignment: center; }
                        Caption { text: query != "" ? "Başka bir isim dene veya filtreleri değiştir." : section == 1 ? "Bir oyunu yıldızla işaretleyerek buraya ekle." : "Oyun klasörünü seç veya bir oyunu elle ekle."; horizontal-alignment: center; }
                        HorizontalLayout { alignment: center; Action { text: query != "" ? "Aramayı temizle" : section == 1 ? "Tüm oyunları göster" : "Oyun klasörü ekle"; clicked => { if query != "" { query = ""; root.refresh(query,section == 1,installed-only,0,source-index); } else if section == 1 { section = 0; root.refresh(query,false,installed-only,0,source-index); } else { root.add-folder(source-index > 0 ? source-index - 1 : 0); } } } }
                    }
                    if matched > 0: ListView { content-y <=> root.scroll-position;
                        for row-data in game-rows: HorizontalLayout { height: root.card-height + 16px; spacing: 16px; alignment: start;
                            for entry in row-data: GameCard { width: root.card-width; height: root.card-height; game: entry; detail(id) => { detail-origin = section; detail-tab = 0; root.detail(id); } launch(id) => { root.launch(id); } favorite(id,value) => { root.favorite(id,value); } }
                        }
                    }
                    HorizontalLayout { spacing: 8px; height: 34px;
                        Text { text: matched == 0 ? "0 oyun" : (offset + 1) + "–" + min(offset + page-size,matched) + " / " + matched + " oyun"; color: Theme.subtle; font-size: 11px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        if matched > page-size: Action { text: "Önceki"; ghost: true; enabled: offset > 0 && !loading; clicked => { root.refresh(query,section == 1,installed-only,max(0,offset - page-size),source-index); } }
                        if matched > page-size: Action { text: "Sonraki"; ghost: true; enabled: offset+page-size < matched && !loading; clicked => { root.refresh(query,section == 1,installed-only,offset+page-size,source-index); } }
                    }
                }
                if section == 9: VerticalLayout { spacing: 18px;
                    HorizontalLayout { spacing: 4px;
                        Action { text: "← Kütüphane"; ghost: true; clicked => { root.return-to-library(); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Action { text: detail-tab == 0 ? "Düzenle" : "Genel bakış"; ghost: true; clicked => { detail-tab = detail-tab == 0 ? 1 : 0; } }
                    }
                    ScrollView { VerticalLayout { spacing: 22px;
                        HorizontalLayout { height: 216px; spacing: 24px;
                            Rectangle { width: 144px; height: 216px; border-radius: 8px; clip: true; background: Theme.surface;
                                if detail-has-artwork: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: root.detail-artwork; image-fit: ImageFit.cover; }
                                if detail-has-artwork: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: @image-url("icons/cover-corners.svg"); colorize: Theme.canvas; image-fit: ImageFit.fill; }
                                if !detail-has-artwork: Glyph { kind: 0; x: parent.width / 2 - 20px; y: parent.height / 2 - 20px; width: 40px; height: 40px; ink: Theme.subtle; }
                            }
                            VerticalLayout { spacing: 14px;
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Eyebrow { text: detail-source; color: Theme.accent; }
                                Text { text: detail-title; color: Theme.text; font-size: 24px; font-weight: 600; wrap: word-wrap; vertical-stretch: 0; }
                                Caption { text: detail-installed ? "Kurulu · " + detail-size : "Kurulum kullanılamıyor"; }
                                HorizontalLayout { spacing: 10px;
                                    Action { text: "Oyna"; icon: 9; accent: true; min-width: 100px; max-width: 100px; enabled: detail-installed; clicked => { root.launch(detail-id); } }
                                    Action { text: ""; icon: 1; selected: detail-favorite; min-width: 32px; max-width: 32px; accessible-label: detail-favorite ? "Favorilerden çıkar" : "Favoriye ekle"; clicked => { root.favorite(detail-id,!detail-favorite); } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                Caption { text: detail-collections == "" ? "Henüz bir koleksiyona eklenmedi" : detail-collections; font-size: 11px; }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                        }
                        if detail-tab == 0: VerticalLayout { spacing: 18px;
                            Panel { VerticalLayout { padding: 20px; spacing: 16px;
                                HorizontalLayout { spacing: 10px; Glyph { kind: 11; } Heading { text: "Ne kadar sürer?"; } Rectangle { horizontal-stretch: 1; background: transparent; } Action { text: "HowLongToBeat ↗"; ghost: true; clicked => { root.completion-open(detail-id,false); } } }
                                HorizontalLayout { spacing: 12px; Metric { label: "Ana hikâye"; value: completion-main; } Metric { label: "Ana + ek içerik"; value: completion-extra; } Metric { label: "Tamamlama"; value: completion-full; } }
                                Caption { text: completion-summary; font-size: 11px; }
                                HorizontalLayout { spacing: 10px; Action { text: "Yenile"; icon: 8; ghost: true; enabled: !integration-busy; clicked => { root.completion-lookup(detail-id,""); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                            } }
                            HorizontalLayout { spacing: 18px;
                                Panel { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; VerticalLayout { padding: 20px; spacing: 12px; Heading { text: "Notların"; } Caption { text: detail-notes == "" ? "Bu oyun için henüz not eklemedin." : detail-notes; } Action { text: "Not ekle / düzenle"; ghost: true; clicked => { detail-tab = 1; } } } }
                                Panel { min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; VerticalLayout { padding: 20px; spacing: 12px; Heading { text: "Son oturumlar"; } Caption { text: detail-history; } } }
                            }
                        }
                        if detail-tab == 1: VerticalLayout { spacing: 18px;
                            Panel { VerticalLayout { padding: 20px; spacing: 12px;
                                Heading { text: "Oyun bilgileri"; }
                                Caption { text: "Başlık"; } Field { text <=> detail-title; placeholder: "Oyun adı"; }
                                Caption { text: "Notların"; } TextEdit { text <=> detail-notes; height: 100px; }
                                Action { text: "Değişiklikleri kaydet"; accent: true; clicked => { root.save-detail(detail-id,detail-title,detail-notes); } }
                            } }
                            Panel { VerticalLayout { padding: 20px; spacing: 12px;
                                Heading { text: "Kapak görseli"; }
                                HorizontalLayout { spacing: 8px; Action { text: "Dosyadan seç"; clicked => { root.cover(detail-id,false); } } Action { text: "Kaynak kapağına dön"; ghost: true; clicked => { root.cover(detail-id,true); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                                HorizontalLayout { spacing: 8px; Field { text <=> remote-cover-url; placeholder: "Kapak görselinin HTTPS adresi"; } Action { text: "İndir"; clicked => { root.remote-cover(detail-id,remote-cover-url); } } }
                                HorizontalLayout { spacing: 8px; Action { text: "SteamGridDB'de ara"; enabled: !integration-busy; clicked => { root.search-covers(detail-id); } } ComboBox { model: cover-names; current-index <=> cover-index; } Action { text: "Seçili kapağı kullan"; enabled: !integration-busy && cover-candidates.length > 0 && cover-index >= 0; clicked => { root.remote-cover(detail-id,cover-candidates[cover-index].url); } } }
                            } }
                            Panel { VerticalLayout { padding: 20px; spacing: 12px;
                                Heading { text: "Koleksiyon"; }
                                Caption { text: detail-collections == "" ? "Henüz koleksiyon seçilmedi." : detail-collections; }
                                HorizontalLayout { spacing: 8px; ComboBox { model: collection-names; current-index <=> detail-collection-index; } Action { text: "Ekle"; enabled: collections.length > 0 && detail-collection-index >= 0; clicked => { root.collection-member(detail-id,collections[detail-collection-index].id,true); } } Action { text: "Çıkar"; ghost: true; enabled: collections.length > 0 && detail-collection-index >= 0; clicked => { root.collection-member(detail-id,collections[detail-collection-index].id,false); } } }
                            } }
                            Panel { VerticalLayout { padding: 20px; spacing: 12px;
                                Heading { text: "HowLongToBeat eşleşmesi"; }
                                Caption { text: "Bulunamayan veya yanlış eşleşen oyunun sayfa adresini seç."; }
                                HorizontalLayout { spacing: 8px; Field { text <=> completion-url; placeholder: "HowLongToBeat oyun URL'si veya ID"; } Action { text: "Eşleştir"; enabled: !integration-busy && completion-url != ""; clicked => { root.completion-lookup(detail-id,completion-url); } } }
                                Action { text: "Oyunu sitede ara ↗"; ghost: true; clicked => { root.completion-open(detail-id,true); } }
                            } }
                            Panel { VerticalLayout { padding: 20px; spacing: 12px;
                                Heading { text: "Kurulum ve oturum takibi"; }
                                Caption { text: detail-path == "" ? "Bu oyun için yerel kurulum yok." : detail-path; }
                                Action { text: "İzlenecek oyun dosyasını seç"; clicked => { root.tracking(detail-id); } }
                            } }
                        }
                    } }
                }
                if section >= 3 && section <= 5: ScrollView { VerticalLayout { spacing: 18px;
                    HorizontalLayout { spacing: 8px;
                        Tab { text: "Steam · " + steam-count; active: section == 3; clicked => { section = 3; } }
                        Tab { text: "Epic · " + epic-count; active: section == 4; clicked => { section = 4; } }
                        Tab { text: "Riot · " + riot-count; active: section == 5; clicked => { section = 5; } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Panel { VerticalLayout { padding: 22px; spacing: 14px;
                        Heading { text: "Yerel oyunlar"; }
                        Caption { text: "Kurulu oyunlar launcher verilerinden otomatik bulunur. Başka bir diskteki klasörü de ekleyebilirsin."; }
                        HorizontalLayout { spacing: 8px; Action { text: "Klasör ekle"; icon: 2; enabled: !scanning; clicked => { root.add-folder(section - 3); } } Action { text: "Oyunları göster"; ghost: true; clicked => { source-index = section - 2; section = 0; root.refresh(query,false,installed-only,0,source-index); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                        Action { text: source-details ? "Tarama ayrıntılarını gizle" : "Tarama ayrıntıları"; ghost: true; clicked => { source-details = !source-details; } }
                        if source-details: Caption { text: source-summaries[section - 3]; font-size: 12px; }
                    } }
                    if section == 3: Panel { VerticalLayout { padding: 22px; spacing: 12px;
                        Heading { text: "Steam hesabı"; } Caption { text: "Kurulu olmayan oyunlarını da eklemek için hesabını eşitle. Anahtar Windows'ta güvenli olarak saklanır."; }
                        Caption { text: "SteamID64"; } Field { text <=> steam-account-id; placeholder: "SteamID64"; }
                        Caption { text: "Kişisel Web API anahtarı"; } Field { text <=> steam-api-key; placeholder: "API anahtarı"; secret: true; }
                        HorizontalLayout { spacing: 8px; Action { text: "Kaydet"; clicked => { root.steam-credentials(steam-account-id,steam-api-key); steam-api-key = ""; } } Action { text: "Hesap oyunlarını eşitle"; accent: true; enabled: !integration-busy; clicked => { root.sync-account(0); } } Action { text: "Anahtar oluştur ↗"; ghost: true; clicked => { root.steam-key-page(); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                        Caption { text: steam-account-status; font-size: 12px; }
                    } }
                    if section == 4: Panel { VerticalLayout { padding: 22px; spacing: 14px;
                        Heading { text: "Epic Games hesabı"; } Caption { text: "Hesabındaki kurulu olmayan oyunları da kütüphanene ekle."; }
                        HorizontalLayout { spacing: 8px; Action { text: "Hesabı bağla"; accent: true; enabled: !integration-busy; clicked => { root.epic-login(); } } Action { text: "Hesap oyunlarını eşitle"; enabled: !integration-busy; clicked => { root.sync-account(1); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                        Caption { text: epic-account-status; font-size: 12px; }
                    } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                } }
                if section == 6: VerticalLayout { spacing: 18px;
                    HorizontalLayout { spacing: 10px; Field { placeholder: "Yeni koleksiyonun adı"; text <=> collection-name; max-width: 440px; } Action { text: "Koleksiyon oluştur"; icon: 7; accent: true; enabled: collection-name != ""; clicked => { root.create-collection(collection-name); collection-name = ""; } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                    if collections.length == 0: Panel { height: 170px; VerticalLayout { padding: 28px; spacing: 12px; Heading { text: "Kendi raflarını oluştur"; } Caption { text: "Bitireceklerim, hafta sonu veya birlikte oynadıklarımız…\nBir koleksiyon oluştur, oyun ayrıntısından oyunlarını ekle."; } } }
                    ListView { for collection in collections: Rectangle { height: 84px; background: transparent;
                        Panel { height: 72px; width: parent.width;
                            HorizontalLayout { padding: 16px; spacing: 14px; Glyph { kind: 2; ink: Theme.accent; } Heading { text: collection.name; overflow: elide; } Caption { text: collection.count + " oyun"; horizontal-stretch: 0; } Rectangle { horizontal-stretch: 1; background: transparent; } Action { text: "Aç"; ghost: true; clicked => { collection-id = collection.id; source-index = 0; section = 0; root.refresh(query,false,installed-only,0,0); } } Action { text: "Sil"; ghost: true; danger: true; clicked => { root.delete-collection(collection.id); } } }
                        }
                    } }
                }
                if section == 7: VerticalLayout { spacing: 14px;
                    HorizontalLayout { height: 34px; spacing: 10px;
                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: bridge-connected ? Theme.positive : Theme.subtle; }
                        Caption { text: social-fixture ? "Örnek veri" : bridge-connected ? "Bağlı" : bridge-enabled ? "Bağlantı bekleniyor" : "Çevrimdışı"; font-size: 12px; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        if !bridge-enabled: Action { text: "Bağlan"; clicked => { bridge-enabled = true; root.bridge-toggle(true); } }
                        if can-mute: Action { text: ""; icon: 14; danger: muted; min-width: 32px; max-width: 32px; accessible-label: muted ? "Mikrofonu aç" : "Mikrofonu sustur"; clicked => { root.bridge-action("mute",""); } }
                        if can-deafen: Action { text: ""; icon: 15; danger: deafened; min-width: 32px; max-width: 32px; accessible-label: deafened ? "Sesi aç" : "Sesi kapat"; clicked => { root.bridge-action("deafen",""); } }
                        if can-stop-stream: Action { text: "Yayını durdur"; clicked => { root.bridge-action("stream_stop",""); } }
                        Action { text: ""; icon: 4; min-width: 32px; max-width: 32px; accessible-label: "Discord bağlantı ayarları"; clicked => { section = 10; } }
                    }
                    HorizontalLayout { spacing: 24px;
                        VerticalLayout { min-width: 0px; horizontal-stretch: 2; spacing: 10px;
                            HorizontalLayout { spacing: 6px;
                                Tab { text: "Arkadaşlar · " + friend-count; active: !friend-favorites-only; clicked => { friend-favorites-only = false; root.social-filter(friend-query,false); } }
                                Tab { text: "Favoriler · " + favorite-friend-count; active: friend-favorites-only; clicked => { friend-favorites-only = true; root.social-filter(friend-query,true); } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Caption { text: recent-conversations ? "Son konuşma" : ""; font-size: 11px; horizontal-stretch: 0; }
                            }
                            if friends.length == 0: Caption { text: !bridge-connected ? "Discord bağlantısı kurulduğunda arkadaşların burada görünür." : friend-favorites-only ? "Bir arkadaşını yıldızla favorilere ekle." : "Aramana uygun arkadaş bulunamadı."; }
                            ListView { for friend in friends: FriendRow { name: friend.name; subtitle: friend.subtitle; initial: friend.initial; online: friend.online; recent: friend.recent; favorite: friend.favorite; can-favorite: can-favorite-friends; enabled: bridge-connected;
                                clicked => { root.bridge-action("open_dm",friend.id); }
                                favorite-clicked => { root.friend-favorite(friend.id,!friend.favorite); }
                            } }
                        }
                        Rectangle { width: 1px; background: Theme.line; }
                        VerticalLayout { min-width: 0px; horizontal-stretch: 1; spacing: 10px;
                            Heading { text: room-mode == 2 ? "Oda seç" : "Ses odaları"; height: 30px; }
                            if room-mode != 2: HorizontalLayout { spacing: 4px;
                                Tab { text: "Dolu"; active: room-mode == 0; clicked => { room-mode = 0; root.room-filter(0,room-query); } }
                                Tab { text: "Favoriler · " + favorite-room-count; active: room-mode == 1; clicked => { room-mode = 1; root.room-filter(1,room-query); } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                if can-room-catalog: Action { text: ""; icon: 7; min-width: 30px; max-width: 30px; accessible-label: "Takip edilecek oda seç"; clicked => { room-mode = 2; root.room-filter(2,room-query); } }
                            }
                            if room-mode == 2: HorizontalLayout { spacing: 4px;
                                Field { placeholder: "Sunucu veya oda ara"; text <=> room-query; edited => { root.room-filter(2,room-query); } }
                                Action { text: "←"; min-width: 30px; max-width: 30px; accessible-label: "Favori odalara dön"; clicked => { room-mode = 1; root.room-filter(1,room-query); } }
                            }
                            if rooms.length == 0: Caption { text: !bridge-connected ? "Discord bağlantısı bekleniyor." : room-catalog-pending ? "Odalar yükleniyor…" : room-mode == 1 ? "Takip etmek için bir odayı yıldızla." : room-mode == 2 ? "Aramana uygun oda bulunamadı." : "Şu anda dolu oda görünmüyor."; font-size: 12px; }
                            ListView { for room in rooms: PersonRow { name: room.name; subtitle: room.subtitle; initial: "#"; online: room.online; enabled: bridge-connected; can-join: room.can-join || room-mode == 2; browse: room-mode == 2; favorite: room.favorite; can-favorite: can-favorite-rooms;
                                clicked => { if room-mode == 2 { root.room-favorite(room.id,!room.favorite); } else { root.bridge-action("join_voice",room.id); } }
                                favorite-clicked => { root.room-favorite(room.id,!room.favorite); }
                            } }
                            if room-mode == 2 && room-catalog-more: Caption { text: "İlk 100 oda gösteriliyor. Aramanı daralt."; font-size: 11px; }
                        }
                    }
                    if bridge-connected && !recent-conversations: Caption { text: "Son konuşma sıralaması için GameLibraryBridge köprüsünü güncelle."; font-size: 11px; }
                }
                if section == 10: ScrollView { VerticalLayout { spacing: 16px;
                    CheckBox { text: "Yerel Discord bağlantısı"; checked <=> bridge-enabled; toggled => { root.bridge-toggle(bridge-enabled); } }
                    Caption { text: bridge-status; font-size: 12px; }
                    Panel { VerticalLayout { padding: 18px; spacing: 12px;
                        Heading { text: "Vencord"; }
                        HorizontalLayout { spacing: 10px;
                            ComboBox { model: ["Discord Stable","Discord PTB","Discord Canary"]; current-index <=> discord-branch; }
                            Rectangle { width: 120px; height: 32px; horizontal-stretch: 0; border-radius: 6px; background: vencord-touch.has-hover ? Theme.hover : transparent; opacity: integration-busy ? 0.45 : 1;
                                accessible-role: button; accessible-label: "Vencord işlemleri"; accessible-enabled: !integration-busy; forward-focus: vencord-keys;
                                accessible-action-default => { if !integration-busy { vencord-options.show({x:0px,y:32px}); } }
                                Text { x: 10px; y: 0px; width: 76px; height: 32px; text: "İşlemler"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                                Image { x: 92px; y: 7px; width: 18px; height: 18px; source: @image-url("icons/more.svg"); colorize: Theme.muted; }
                                vencord-keys := FocusScope { enabled: !integration-busy; key-pressed(event) => { if event.text == "\n" || event.text == " " { vencord-options.show({x:0px,y:32px}); return accept; } return reject; } }
                                vencord-touch := TouchArea { enabled: !integration-busy; mouse-cursor: pointer; clicked => { vencord-keys.focus(); vencord-options.show({x:0px,y:32px}); } }
                                vencord-options := ContextMenuArea { width: 0px; height: 0px; Menu {
                                    MenuItem { title: "Kur"; enabled: !integration-busy; activated => { root.installer(0,discord-branch); } }
                                    MenuItem { title: "Onar / güncelle"; enabled: !integration-busy; activated => { root.installer(1,discord-branch); } }
                                    MenuItem { title: "Kaldır"; enabled: !integration-busy; activated => { root.installer(2,discord-branch); } }
                                } }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        Action { text: "Köprüyü hazırla / güncelle"; enabled: !integration-busy; clicked => { root.prepare-bridge(); } }
                        Caption { text: "Arkadaş favorileri ve son konuşma sıralaması güncel GameLibraryBridge sürümünü kullanır."; font-size: 12px; }
                    } }
                    Panel { VerticalLayout { padding: 18px; spacing: 12px;
                        Heading { text: "Doğrudan erişim"; }
                        HorizontalLayout { spacing: 8px; Field { text <=> discord-target-id; placeholder: "Arkadaş veya ses kanalı ID"; } Action { text: "Görüşme"; enabled: bridge-connected && discord-target-id != ""; clicked => { root.bridge-action("open_dm",discord-target-id); } } Action { text: "Kanala gir"; enabled: bridge-connected && discord-target-id != ""; clicked => { root.bridge-action("join_voice",discord-target-id); } } }
                    } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                } }
                if section == 8: ScrollView { VerticalLayout { spacing: 18px;
                    Panel { VerticalLayout { padding: 22px; spacing: 14px;
                        HorizontalLayout { Heading { text: "Game Library"; } Rectangle { horizontal-stretch: 1; background: transparent; } Caption { text: "Sürüm 0.1.0 · Windows"; horizontal-stretch: 0; } }
                        Caption { text: update-status; }
                        CheckBox { text: "Güncellemeleri otomatik kontrol et ve indir"; checked <=> auto-update-app; toggled => { root.update-preferences(auto-update-app,auto-update-vencord); } }
                        HorizontalLayout { spacing: 8px; Action { text: "Güncellemeleri kontrol et"; icon: 8; enabled: !integration-busy; clicked => { root.update-check(); } } if update-available: Action { text: "İndir ve doğrula"; accent: true; enabled: !integration-busy; clicked => { root.update-stage(); } } if update-staged: Action { text: "Yeniden başlat ve uygula"; accent: true; enabled: !integration-busy; clicked => { root.update-apply(); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                    } }
                    Panel { VerticalLayout { padding: 22px; spacing: 14px;
                        Heading { text: "Vencord güncellemeleri"; }
                        CheckBox { text: "Vencord'un otomatik güncellemesini kullan"; checked <=> auto-update-vencord; toggled => { root.update-preferences(auto-update-app,auto-update-vencord); } }
                        Caption { text: "Güncellemeler Discord yeniden açıldığında etkinleşir."; font-size: 12px; }
                        Action { text: "Vencord'u güncelle"; enabled: bridge-connected; clicked => { root.bridge-action("vencord_update",""); } }
                    } }
                    Panel { VerticalLayout { padding: 22px; spacing: 14px;
                        Heading { text: "Kapak sağlayıcısı"; }
                        Caption { text: "SteamGridDB anahtarı, alternatif kapakları oyun ayrıntısından aramanı sağlar."; }
                        HorizontalLayout { spacing: 8px; Field { text <=> artwork-api-key; secret: true; placeholder: "SteamGridDB API anahtarı"; } Action { text: "Anahtarı kaydet"; clicked => { root.artwork-key(artwork-api-key); artwork-api-key = ""; } } }
                    } }
                    HorizontalLayout { Action { text: "Hakkında"; ghost: true; clicked => { root.about(); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                } }
                if section == 2: VerticalLayout { spacing: 18px;
                    HorizontalLayout { spacing: 16px; Metric { label: "Özel RAM"; value: ram; } Metric { label: "CPU"; value: cpu; } Metric { label: "Özel commit"; value: commit-size; } }
                    Panel { VerticalLayout { padding: 22px; spacing: 14px;
                        Heading { text: "Kaynak ölçümü"; }
                        Caption { text: "Yalnızca Game Library süreçleri ölçülür. İlk örnekte CPU henüz bilinmez. Kütüphane ekranında sürekli ölçüm yapılmaz."; }
                        HorizontalLayout { spacing: 8px; Action { text: "Anlık ölçüm"; enabled: !measuring; clicked => { root.sample(); } } Action { text: measuring ? "İptal et" : "60 saniye ölç"; accent: true; clicked => { if measuring { root.cancel-measurement(); } else { root.measure(); } } } Action { text: "Raporları aç"; ghost: true; clicked => { root.open-reports(); } } Rectangle { horizontal-stretch: 1; background: transparent; } }
                        Caption { text: measuring ? "Ölçüm sürüyor · " + measurement-progress + " / 60 sn" : measurement-summary; }
                    } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }
    }
    }
}
