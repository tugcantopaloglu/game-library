import { ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, Action, Field, Panel, Heading, Caption } from "design.slint";

export struct AttachmentTile { id: string, name: string, detail: string, preview: image, has-preview: bool }
export struct ChatMessageTile {
    attachments: [AttachmentTile],
    id: string,
    author: string,
    content: string,
    time: string,
    own: bool,
}

component MessageRow inherits Rectangle {
    in property <ChatMessageTile> message;
    callback open-attachment(string,string);
    min-width: 0px;
    height: bubble.height + 10px;
    background: transparent;
    accessible-role: list-item;
    accessible-label: message.author + " · " + message.time;

    bubble := Panel {
        x: root.message.own ? max(32px, parent.width - self.width) : 0px;
        width: max(0px, min(800px, parent.width - 32px));
        height: bubble-content.preferred-height;
        background: root.message.own ? Theme.accent-surface : Theme.surface;
        clip: true;
        bubble-content := VerticalLayout {
            padding: 12px;
            spacing: 7px;
            HorizontalLayout {
                height: 17px;
                vertical-stretch: 0;
                spacing: 12px;
                Text {
                    text: root.message.author;
                    min-width: 0px;
                    color: root.message.own ? Theme.accent : Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: root.message.time;
                    color: Theme.subtle;
                    font-size: 11px;
                    horizontal-stretch: 0;
                    width: 46px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    accessible-label: "Mesaj zamanı " + root.message.time;
                }
            }
            if root.message.content != "": Text {
                text: root.message.content;
                min-width: 0px;
                color: Theme.text;
                font-size: 13px;
                wrap: word-wrap;
                overflow: elide;
                max-lines: 40;
                vertical-stretch: 0;
            }
            for attachment in root.message.attachments: VerticalLayout {
                spacing: 6px;
                if attachment.has-preview: Image {
                    height: 180px; min-width: 0px; vertical-stretch: 0;
                    source: attachment.preview; image-fit: contain;
                    accessible-label: attachment.name + " görsel önizlemesi";
                }
                Action { text: attachment.name + " · " + attachment.detail; height: 40px; min-width: 0px; max-width: parent.width;
                    accessible-label: attachment.name + " ekini tarayıcıda aç";
                    clicked => { root.open-attachment(root.message.id,attachment.id); }
                }
            }
        }
    }
}

export component Conversation inherits Rectangle {
    in property <string> friend-name;
    in property <string> conversation-id;
    in property <string> confirmed-nonce;
    in property <[ChatMessageTile]> messages;
    in property <string> status;
    in property <bool> loading;
    in property <bool> can-load-older;
    in property <bool> history-loading;
    in property <bool> retry-available;
    in property <bool> pending;
    in property <bool> can-send;
    in property <bool> can-open-discord;
    in-out property <string> draft;
    callback send(string);
    callback refresh();
    callback older();
    callback open-attachment(string,string);
    callback retry();
    callback close();
    callback open-discord();

    in property <bool> compact;
    private property <length> previous-height;
    private property <bool> preserve-history;
    private property <string> accepted-draft;
    private property <bool> follow-latest: true;
    private property <bool> send-enabled: root.can-send && !root.pending && !root.loading
        && root.draft != "" && root.draft.character-count <= 2000;

    // Model installation and confirmation remain the worker's responsibility.
    public function scroll-to-latest() {
        root.follow-latest = true;
        history.content-y = min(0px, history.visible-height - history.content-height);
    }
    changed messages => {
        if root.follow-latest { root.scroll-to-latest(); }
    }
    changed conversation-id => { root.preserve-history = false; root.scroll-to-latest(); }
    changed confirmed-nonce => { if root.confirmed-nonce != "" { root.scroll-to-latest(); } }
    changed draft => {
        if root.draft.character-count <= 2000 { root.accepted-draft = root.draft; }
    }

    min-width: 0px;
    min-height: 320px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: 10px;
    clip: true;
    accessible-role: groupbox;
    accessible-label: friend-name + " ile Discord sohbeti";
    forward-focus: composer;

    VerticalLayout {
        padding: root.compact ? 12px : 16px;
        spacing: root.compact ? 6px : 12px;
        VerticalLayout {
            vertical-stretch: 0;
            spacing: root.compact ? 6px : 12px;
            Heading {
                text: root.friend-name;
                min-width: 0px;
                overflow: elide;
                vertical-alignment: center;
            }
            HorizontalLayout { spacing: 8px;
            Action {
                text: "Discord'da aç";
                height: 40px;
                enabled: root.can-open-discord;
                clicked => { root.open-discord(); }
            }
            Action {
                text: root.loading ? "Yükleniyor…" : root.retry-available ? "Tekrar dene" : "Yenile";
                icon: 8;
                height: 40px;
                accent: root.retry-available;
                enabled: !root.loading && !root.pending;
                accessible-label: root.retry-available ? "Bu kişiyle sohbeti yeniden aç" : "Sohbet mesajlarını yenile";
                clicked => { if root.retry-available { root.retry(); } else { root.refresh(); } }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Action {
                text: "Kapat";
                height: 40px;
                accessible-label: "Sohbeti kapat";
                clicked => { root.close(); }
            }
            }
        }
        Rectangle { height: 1px; vertical-stretch: 0; background: Theme.line; }
        if root.status != "": Caption {
            text: root.status;
            max-lines: root.compact && !root.retry-available ? 1 : 3;
            overflow: elide;
            accessible-label: "Sohbet durumu " + root.status;
            color: root.retry-available ? Theme.warning : Theme.muted;
        }
        HorizontalLayout { vertical-stretch: 0; spacing: 10px;
            Action { text: root.history-loading ? "Yükleniyor…" : "Önceki mesajlar";
                height: 40px; accessible-label: "Önceki 30 mesajı yükle"; enabled: root.can-load-older && !root.loading && !root.pending;
                clicked => { root.follow-latest = false; root.preserve-history = true; root.previous-height = history.content-height; root.older(); }
            }
            Caption { text: root.messages.length + " / 150 mesaj"; font-size: 11px; }
        }
        Rectangle {
            min-height: root.compact ? 40px : 100px;
            min-width: 0px;
            vertical-stretch: 1;
            background: transparent;
            history := ScrollView {
                width: parent.width;
                height: parent.height;
                horizontal-scrollbar-policy: always-off;
                accessible-role: list;
                accessible-label: root.friend-name + " sohbet mesajları";
                scrolled => {
                    root.follow-latest = self.content-y <= min(0px, self.visible-height - self.content-height) + 48px;
                }
                changed content-height => {
                    if root.preserve-history {
                        self.content-y = self.content-y - (self.content-height - root.previous-height);
                        root.previous-height = self.content-height;
                        if !root.history-loading { root.preserve-history = false; }
                    } else if root.follow-latest { root.scroll-to-latest(); }
                }
                changed visible-height => { if root.follow-latest { root.scroll-to-latest(); } }
                VerticalLayout {
                    spacing: 0px;
                    for message in root.messages: MessageRow {
                        width: history.visible-width;
                        vertical-stretch: 0;
                        message: message;
                        open-attachment(message,attachment) => { root.open-attachment(message,attachment); }
                    }
                }
            }
            if root.messages.length == 0: VerticalLayout {
                padding: 20px;
                alignment: center;
                spacing: 8px;
                Heading {
                    text: root.loading ? "Mesajlar yükleniyor…" : root.retry-available ? "Görüşme açılamadı" : "Henüz gösterilecek mesaj yok";
                    horizontal-alignment: center;
                }
                Caption {
                    text: root.loading ? "Discord bağlantısı bekleniyor." : root.retry-available ? "Üstteki Tekrar dene düğmesiyle aynı kişiyi yeniden açabilirsin." : "Mesajları almak için Yenile'yi seç.";
                    horizontal-alignment: center;
                }
            }
        }
        if !root.follow-latest && root.messages.length > 0: HorizontalLayout {
            alignment: end;
            vertical-stretch: 0;
            Action { text: "Son mesaja git"; clicked => { root.scroll-to-latest(); } }
        }
        Rectangle { height: 1px; vertical-stretch: 0; background: Theme.line; }
        composer := TextEdit {
            min-width: 0px;
            height: root.retry-available ? 0px : root.compact ? 54px : 78px;
            visible: !root.retry-available;
            vertical-stretch: 0;
            text <=> root.draft;
            placeholder-text: root.can-send ? "Mesaj yaz…" : "Bu görüşmede mesaj gönderilemiyor.";
            accessible-label: root.friend-name + " için mesaj taslağı";
            enabled: root.can-send && !root.pending && !root.loading;
            wrap: word-wrap;
            font-size: 13px;
            edited(value) => {
                if value.character-count > 2000 { root.draft = root.accepted-draft; }
                else { root.accepted-draft = value; }
            }
            key-pressed(event) => {
                if event.text == "\n" && !event.modifiers.shift {
                    if root.send-enabled { root.scroll-to-latest(); root.send(root.draft); }
                    return accept;
                }
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
        }
        if !root.retry-available: HorizontalLayout {
            vertical-stretch: 0;
            spacing: 12px;
            Caption {
                text: "Enter: gönder · Shift+Enter: yeni satır";
                min-width: 0px;
                font-size: 11px;
            }
            Text {
                text: root.draft.character-count + " / 2000";
                color: root.draft.character-count >= 2000 ? Theme.accent : Theme.subtle;
                font-size: 11px;
                horizontal-stretch: 0;
                vertical-alignment: center;
                accessible-label: "Mesaj karakter sayısı " + root.draft.character-count + ", sınır 2000";
            }
            Action {
                text: root.pending ? "Gönderiliyor…" : "Gönder";
                height: 40px;
                accent: true;
                enabled: root.send-enabled;
                accessible-label: root.friend-name + " kişisine mesaj gönder";
                clicked => { root.scroll-to-latest(); root.send(root.draft); }
            }
        }
    }
}
