export global Theme {
    out property <color> canvas: #101321;
    out property <color> sidebar: #141829;
    out property <color> surface: #1b2137;
    out property <color> hover: #282f48;
    out property <color> line: #303953;
    out property <color> text: #f2f4fa;
    out property <color> muted: #b6bfd4;
    out property <color> subtle: #929eb9;
    out property <color> accent: #d4f879;
    out property <color> accent-surface: #293523;
    out property <color> accent-surface-hover: #35452c;
    out property <color> accent-ink: #18200f;
    out property <color> accent-hover: #e2ff9a;
    out property <color> accent-pressed: #b8dd5d;
    out property <color> secondary: #beb2f4;
    out property <color> positive: #97ddb3;
    out property <color> warning: #f1c781;
    out property <color> danger: #f2a1ad;
}

export component Brand inherits Rectangle {
    in property <int> kind;
    width: 28px; height: 28px; horizontal-stretch: 0; vertical-stretch: 0; background: transparent;
    Image { width: parent.width; height: parent.height; image-fit: ImageFit.contain; source: kind == 1 ? @image-url("logos/steam.png") : kind == 2 ? @image-url("logos/epic.png") : kind == 3 ? @image-url("logos/riot.png") : kind == 4 ? @image-url("logos/discord.png") : kind == 5 ? @image-url("logos/spotify.png") : kind == 6 ? @image-url("logos/nvidia.png") : kind == 7 ? @image-url("logos/obs.png") : kind == 8 ? @image-url("logos/cloudflare.png") : kind == 9 ? @image-url("logos/goodbyedpi.png") : @image-url("logos/game-library.png"); }
}
export component Glyph inherits Rectangle {
    in property <int> kind;
    in property <bool> filled;
    in property <color> ink: Theme.muted;
    width: 18px; preferred-height: 18px; background: transparent;
    if root.kind == 3: Brand { kind: 4; width: parent.width; height: parent.width; y: (parent.height - self.height) / 2; }
    if root.kind != 3: Image {
        x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: parent.width;
        colorize: root.ink;
        source: root.kind == 1 ? (root.filled ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg")) : root.kind == 2 ? @image-url("icons/folder.svg") : root.kind == 3 ? @image-url("icons/chat.svg") : root.kind == 4 ? @image-url("icons/settings.svg") : root.kind == 5 ? @image-url("icons/activity.svg") : root.kind == 6 ? @image-url("icons/search.svg") : root.kind == 7 ? @image-url("icons/plus.svg") : root.kind == 8 ? @image-url("icons/refresh.svg") : root.kind == 9 ? @image-url("icons/play.svg") : root.kind == 10 ? @image-url("icons/arrow.svg") : root.kind == 11 ? @image-url("icons/clock.svg") : root.kind == 12 ? @image-url("icons/tray.svg") : root.kind == 14 ? @image-url("icons/microphone.svg") : root.kind == 15 ? @image-url("icons/speaker.svg") : @image-url("icons/grid.svg");
    }
}
export component Action inherits Rectangle {
    in property <string> text;
    in property <int> icon: -1;
    in property <bool> accent;
    in property <bool> ghost;
    in property <bool> selected;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    min-width: content.preferred-width + 24px;
    max-width: content.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: 8px;
    border-width: keys.has-focus ? 2px : 0px;
    border-color: accent && enabled ? Theme.accent-ink : Theme.accent;
    background: !enabled ? (ghost ? transparent : Theme.surface) : accent ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent) : selected ? (touch.pressed ? Theme.line : touch.has-hover ? Theme.accent-surface-hover : Theme.accent-surface) : touch.pressed ? Theme.line : touch.has-hover ? Theme.hover : ghost ? transparent : Theme.surface;
    opacity: enabled ? 1 : 0.6;
    forward-focus: keys;
    accessible-role: button; accessible-label: text; accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    content := HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        alignment: center; spacing: 8px;
        if icon >= 0: Glyph { kind: root.icon; filled: root.selected; ink: root.accent && root.enabled ? Theme.accent-ink : root.danger ? Theme.danger : root.selected ? Theme.accent : Theme.muted; }
        if root.text != "": Text { text: root.text; min-width: 0px; overflow: elide; color: root.accent && root.enabled ? Theme.accent-ink : root.danger ? Theme.danger : root.selected ? Theme.accent : Theme.text; font-size: 13px; font-weight: root.accent || root.selected ? 600 : 500; vertical-alignment: center; vertical-stretch: 0; }
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => { if event.text == "\n" || event.text == " " { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { keys.focus(); root.clicked(); } }
}

export component Navigation inherits Rectangle {
    in property <string> text;
    in property <int> icon: -1;
    in property <int> brand: -1;
    in property <string> count;
    in property <string> monogram;
    in property <bool> active;
    in property <bool> filter;
    callback clicked;
    height: 42px; min-width: 0px;
    border-radius: 10px;
    background: active ? (filter ? (touch.has-hover ? Theme.accent-surface-hover : Theme.accent-surface) : touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent) : touch.pressed ? Theme.line : touch.has-hover ? Theme.hover : transparent;
    border-width: keys.has-focus ? 2px : 0px; border-color: active && !filter ? Theme.accent-ink : Theme.accent;
    accessible-role: button; accessible-label: text; forward-focus: keys;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 12px;
        if root.brand >= 0: Rectangle { width: 18px; horizontal-stretch: 0; background: transparent;
            Brand { kind: root.brand; x: 0px; y: (parent.height - self.height) / 2; width: 18px; height: 18px; }
        }
        if root.brand < 0 && icon >= 0: Glyph { kind: root.icon; ink: root.active ? (root.filter ? Theme.accent : Theme.accent-ink) : Theme.muted; }
        if root.brand < 0 && icon < 0: Text { text: monogram; width: 18px; color: root.active ? (root.filter ? Theme.accent : Theme.accent-ink) : Theme.muted; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: root.text; min-width: 0px; color: root.active ? (root.filter ? Theme.accent : Theme.accent-ink) : Theme.muted; font-size: 13px; font-weight: root.active ? 600 : 500; overflow: elide; vertical-alignment: center; }
        if count != "": Rectangle {
            min-width: count-label.preferred-width + 12px; max-width: count-label.preferred-width + 12px;
            horizontal-stretch: 0; background: transparent;
            Rectangle { x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: 22px; border-radius: 6px;
                background: root.active && !root.filter ? Theme.accent-ink : Theme.surface;
                count-label := Text { text: root.count; color: root.active ? Theme.accent : Theme.muted; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    keys := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { keys.focus(); root.clicked(); } }
}

export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> secret;
    in property <int> icon: -1;
    callback edited;
    callback focus-input;
    focus-input => { input.focus(); }
    height: 38px; min-width: 0px;
    background: Theme.surface;
    border-width: 1px; border-color: input.has-focus ? Theme.accent : Theme.line; border-radius: 8px;
    forward-focus: input;
    HorizontalLayout {
        padding-left: 13px; padding-right: 13px; spacing: 10px;
        if icon >= 0: Glyph { kind: root.icon; }
        Rectangle {
            background: transparent;
            if input.text == "": Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.placeholder; color: Theme.subtle; font-size: 13px; vertical-alignment: center; overflow: elide; }
            input := TextInput {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                text <=> root.text; single-line: true; input-type: root.secret ? InputType.password : InputType.text;
                accessible-label: root.placeholder;
                color: Theme.text; font-size: 13px; vertical-alignment: center;
                selection-background-color: Theme.accent; selection-foreground-color: Theme.accent-ink;
                edited => { root.edited(); }
            }
        }
    }
}

export component Panel inherits Rectangle {
    min-width: 0px; max-width: 4096px;
    vertical-stretch: 0;
    background: Theme.surface;
    border-width: 0px; border-color: Theme.line; border-radius: 12px;
}

export component Heading inherits Text {
    color: Theme.text; font-size: 15px; font-weight: 600; vertical-stretch: 0;
}

export component Caption inherits Text {
    color: Theme.muted; font-size: 13px; wrap: word-wrap; vertical-stretch: 0;
}

export component Eyebrow inherits Text {
    color: Theme.subtle; font-size: 10px; font-weight: 600; vertical-stretch: 0;
}

export component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 70px; min-width: 0px; max-width: 4096px; preferred-width: 0px; horizontal-stretch: 1; background: transparent;
    VerticalLayout { padding: 16px; spacing: 8px;
        Text { text: root.label; color: Theme.muted; font-size: 12px; vertical-stretch: 0; }
        Text { text: root.value; color: Theme.text; font-size: 24px; font-weight: 600; vertical-stretch: 0; overflow: elide; }
    }
}

export component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 34px; min-width: label.preferred-width + 24px; max-width: label.preferred-width + 24px; horizontal-stretch: 0;
    border-radius: 8px;
    background: active ? (touch.pressed ? Theme.line : touch.has-hover ? Theme.accent-surface-hover : Theme.accent-surface) : touch.pressed ? Theme.line : touch.has-hover ? Theme.surface : transparent;
    border-width: keys.has-focus ? 1px : 0px; border-color: Theme.accent;
    label := Text { text: root.text; color: root.active ? Theme.accent : Theme.muted; font-size: 13px; font-weight: root.active ? 600 : 500; vertical-alignment: center; horizontal-alignment: center; }
    accessible-role: button; accessible-label: text; forward-focus: keys;
    accessible-action-default => { root.clicked(); }
    keys := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { keys.focus(); root.clicked(); } }
}

export component PersonRow inherits Rectangle {
    in property <string> name;
    in property <string> subtitle;
    in property <string> initial;
    in property <bool> online;
    in property <bool> enabled: true;
    in property <bool> can-join: true;
    in property <bool> browse;
    in property <bool> favorite;
    in property <bool> can-favorite;
    callback clicked;
    callback favorite-clicked;
    height: 56px; min-width: 0px;
    border-radius: 8px; background: touch.pressed ? Theme.line : touch.has-hover ? Theme.hover : transparent;
    border-width: keys.has-focus ? 1px : 0px; border-color: Theme.accent;
    touch := TouchArea { enabled: root.enabled && root.can-join; mouse-cursor: pointer; clicked => { keys.focus(); root.clicked(); } }
    HorizontalLayout { padding: 10px; spacing: 12px;
        Rectangle { width: 34px; height: 34px; horizontal-stretch: 0; vertical-stretch: 0; border-radius: 17px; background: Theme.accent-surface;
            Text { text: root.initial; color: Theme.accent; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { x: parent.width - self.width; y: parent.height - self.height; width: 13px; height: 13px; border-radius: 6.5px; border-width: 2px; border-color: Theme.surface; background: root.online ? Theme.positive : Theme.subtle; }
        }
        VerticalLayout { spacing: 3px;
            Text { text: root.name; color: Theme.text; font-size: 13px; overflow: elide; vertical-stretch: 0; }
            Text { text: root.subtitle; color: Theme.muted; font-size: 11px; overflow: elide; vertical-stretch: 0; }
        }
        Action { text: ""; icon: 1; selected: root.favorite; ghost: true; min-width: 30px; max-width: 30px; opacity: root.favorite ? 1 : touch.has-hover || keys.has-focus ? 1 : 0.65; enabled: root.enabled && root.can-favorite; accessible-label: root.favorite ? root.name + " takibi bırak" : root.name + " takip et"; clicked => { root.favorite-clicked(); } }
    }
    accessible-role: button; accessible-label: name; accessible-enabled: enabled; forward-focus: keys;
    accessible-action-default => { if root.enabled && root.can-join { root.clicked(); } }
    keys := FocusScope { enabled: root.enabled; key-pressed(event) => { if (event.text == " " || event.text == "\n") && root.can-join { root.clicked(); return accept; } if event.text == "f" && !event.modifiers.control && root.can-favorite { root.favorite-clicked(); return accept; } return reject; } }
    ContextMenuArea { enabled: !root.browse; Menu { MenuItem { title: "Odaya katıl"; enabled: root.enabled && root.can-join; activated => { root.clicked(); } } MenuItem { title: root.favorite ? "Takibi bırak" : "Takip et"; enabled: root.enabled && root.can-favorite; activated => { root.favorite-clicked(); } } } }
}

export component FriendRow inherits Rectangle {
    in property <string> game;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <string> presence;
    in property <string> voice;
    in property <string> name;
    in property <string> subtitle;
    in property <string> initial;
    in property <string> recent;
    in property <int> unread;
    in property <bool> online;
    in property <bool> favorite;
    in property <bool> can-favorite;
    in property <bool> enabled: true;
    callback clicked;
    callback favorite-clicked;
    height: game != "" ? (voice == "" ? 96px : 112px) : voice == "" ? 64px : 80px; min-width: 0px;
    border-radius: 10px; background: touch.pressed ? Theme.line : touch.has-hover ? Theme.hover : transparent;
    border-width: keys.has-focus ? 1px : 0px; border-color: Theme.accent;
    forward-focus: keys;
    accessible-role: button; accessible-label: name + " · " + subtitle + " · " + voice + (unread > 0 ? " · " + unread + " okunmamış mesaj" : "") + (favorite ? " · favori" : ""); accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { keys.focus(); root.clicked(); } }
    HorizontalLayout { padding: 10px; spacing: 8px;
        Rectangle { width: 36px; height: 36px; horizontal-stretch: 0; vertical-stretch: 0; border-radius: 12px; background: Theme.accent-surface;
            Rectangle { width: 36px; height: 36px; border-radius: 12px; clip: true; background: transparent;
                if root.has-avatar: Image { width: parent.width; height: parent.height; source: root.avatar; image-fit: ImageFit.cover; }
                if !root.has-avatar: Text { text: root.initial; color: Theme.accent; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { x: parent.width - self.width; y: parent.height - self.height; width: 12px; height: 12px; border-radius: 6px; background: root.presence == "idle" ? Theme.warning : root.presence == "dnd" ? Theme.danger : root.online ? Theme.positive : Theme.subtle; border-width: 2px; border-color: Theme.sidebar; }
        }
        VerticalLayout { min-width: 0px; spacing: 3px;
            Text { text: root.name; min-width: 0px; color: Theme.text; font-size: 13px; font-weight: 500; overflow: elide; vertical-stretch: 0; }
            Text { text: root.subtitle; min-width: 0px; color: Theme.muted; font-size: 11px; overflow: elide; vertical-stretch: 0; }
            if root.game != "": Text { text: "Oynuyor · " + root.game; min-width: 0px; color: Theme.positive; font-size: 11px; wrap: word-wrap; max-lines: 2; overflow: elide; vertical-stretch: 0; }
            if root.voice != "": Text { text: "Ses · " + root.voice; min-width: 0px; color: Theme.secondary; font-size: 10px; overflow: elide; vertical-stretch: 0; }
        }
        if root.unread > 0 || root.recent != "": VerticalLayout {
            horizontal-stretch: 0; spacing: 4px; alignment: center;
            if root.unread > 0: Rectangle { width: 28px; height: 20px; horizontal-stretch: 0; vertical-stretch: 0; border-radius: 6px; background: Theme.accent;
                Text { text: root.unread > 99 ? "99+" : "" + root.unread; color: Theme.accent-ink; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            if root.recent != "": Text { text: root.recent; color: Theme.subtle; font-size: 10px; horizontal-stretch: 0; vertical-stretch: 0; horizontal-alignment: right; }
        }
        Action { text: ""; icon: 1; selected: root.favorite; height: 32px; min-width: 32px; max-width: 32px; ghost: true; opacity: root.favorite ? 1 : touch.has-hover || keys.has-focus ? 1 : 0.65; enabled: root.can-favorite; accessible-label: root.favorite ? root.name + " favorilerden çıkar" : root.name + " favoriye ekle"; clicked => { root.favorite-clicked(); } }
    }
    keys := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == "\n" || event.text == " " { root.clicked(); return accept; } if event.text == "f" && !event.modifiers.control && root.can-favorite { root.favorite-clicked(); return accept; } return reject; } }
    ContextMenuArea { Menu { MenuItem { title: "Görüşmeyi aç"; enabled: root.enabled; activated => { root.clicked(); } } MenuItem { title: root.favorite ? "Favorilerden çıkar" : "Favoriye ekle"; enabled: root.can-favorite; activated => { root.favorite-clicked(); } } } }
}
